# Aegis configuration — copy to `.env` and `source` it, or export the vars you
# want to override. Every value has a sensible default; nothing here is required.

# ---- Web server -------------------------------------------------------------
# AEGIS_HOST=0.0.0.0
# AEGIS_PORT=8000
# AEGIS_STREAM_FPS=20

# ---- Mode switches ----------------------------------------------------------
# Force everything to mock (no camera / GPU / arm needed):
# AEGIS_MOCK=1
# Fail loudly instead of falling back to mocks when hardware is missing:
# AEGIS_STRICT=1

# ---- Camera (wrist / eye-in-hand webcam) ------------------------------------
# Webcam index, device path, or stream URL:
# AEGIS_CAMERA_INDEX=0
# AEGIS_FRAME_WIDTH=640
# AEGIS_FRAME_HEIGHT=480
# AEGIS_MOCK_CAMERA=1

# ---- Detector (the CNN) -----------------------------------------------------
# AEGIS_DETECTOR=yolo                # or "mock"
# AEGIS_YOLO_MODEL=yolov8n.pt        # n<s<m<l<x : bigger = stronger, slower
# AEGIS_CONFIDENCE=0.40
# AEGIS_DEVICE=cpu                   # or "cuda" / "cuda:0"
# AEGIS_MOCK_LABEL=bottle            # label the mock detector reports

# ---- Robot (Feetech STS3215 serial bus) -------------------------------------
# AEGIS_SERIAL_PORT=/dev/ttyACM0     # macOS: /dev/tty.usbmodem*  Windows: COM5
# AEGIS_BAUDRATE=1000000
# AEGIS_MOCK_ROBOT=1
# AEGIS_MOVE_SPEED=600
# AEGIS_MOVE_ACCEL=30

# ---- Visual-servoing control ------------------------------------------------
# Which joints pan (horizontal) and tilt (vertical) the camera:
# AEGIS_PAN_JOINT=shoulder_pan
# AEGIS_TILT_JOINT=wrist_flex
# Proportional gains (deg of motion per unit of normalised error):
# AEGIS_KP_PAN=12.0
# AEGIS_KP_TILT=10.0
# Axis directions — flip to +1/-1 if the arm drives away from the target:
# AEGIS_PAN_SIGN=-1.0
# AEGIS_TILT_SIGN=1.0
# Centre tolerance and per-tick safety clamp:
# AEGIS_DEADZONE=0.06
# AEGIS_MAX_STEP_DEG=4.0
# AEGIS_LOOP_HZ=15.0
